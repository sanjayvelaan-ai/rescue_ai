# ==============================================================================
# Deployment Environment Configuration Template
# ==============================================================================

# [Render Backend Environment Variables]
PORT=8000
MODEL_PATH=/app/backend/models/best.pt
CAMERA_ENABLED=false
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.50
TORCH_NUM_THREADS=1
SEED_DEMO_DATA=false

# Render CORS: Set to your exact production Vercel frontend URL (no trailing slash)
# Example: https://rescue-ai-drone.vercel.app
CORS_ORIGINS=https://localhost:5173,https://127.0.0.1:5173

# [Vercel Frontend Build Environment Variable]
# Set in Vercel Project Settings -> Environment Variables
# Set to your exact production Render backend URL (no trailing slash)
# Example: https://rescue-ai-drone-api.onrender.com
VITE_BACKEND_ORIGIN=
