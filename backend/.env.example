# Local example; deployment values are in render.yaml.
MODEL_PATH=models/best.pt
CAMERA_ENABLED=false
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=cpu
GPS_MODE=SIMULATION
SEED_DEMO_DATA=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL defaults to the absolute backend/data/rescueeye.db path.
# Set TORCH_NUM_THREADS to match allocated CPU cores on the host.
